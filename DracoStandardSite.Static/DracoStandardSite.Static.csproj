<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Static version of the public site. Runs entirely in the browser and reads
    its data from wwwroot/data/*.json, so it can be hosted for free on
    Cloudflare Pages with no server or database connection.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Same root namespace as the original project so the copied components compile unchanged. -->
    <RootNamespace>DracoStandardSite</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Blazor-ApexCharts" Version="7.0.0" />
    <PackageReference Include="BlazorTableExtended" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DracoStandardSite.Shared\DracoStandardSite.Shared.csproj" />
  </ItemGroup>

</Project>
