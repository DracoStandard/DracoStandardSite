@page "/army-builder"
@page "/army-builder/{ShareToken}"
@using BatailleEmpire.Data.Models
@using BatailleEmpire.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IArmyDataService ArmyData
@inject IPointsCalculatorService PointsCalc
@inject IArmyBuildService BuildService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Army Builder — Bataille Empire</PageTitle>

<div class="be-builder">

    @* ── Header ── *@
    <div class="be-header">
        <h1>Army Builder</h1>
        <div class="be-points-bar">
            <span class="pts-total @PointsClass">@TotalPoints pts</span>
            <span class="pts-label">/ 300 max</span>
            @if (ValidationMessages.Any(m => m.Level == Severity.Error))
            {
                <span class="badge-error">@ValidationMessages.Count(m => m.Level == Severity.Error) error(s)</span>
            }
        </div>
    </div>

    @* ── Step tabs ── *@
    <div class="be-steps">
        <button class="step-tab @(BuildState.WizardStep == 1 ? "active" : "")"
                @onclick="() => GoToStep(1)">
            <span class="step-num">1</span> Select Army
        </button>
        <button class="step-tab @(BuildState.WizardStep == 2 ? "active" : "")"
                disabled="@(BuildState.SelectedArmyId == null)"
                @onclick="() => GoToStep(2)">
            <span class="step-num">2</span> Add Divisions
        </button>
        <button class="step-tab @(BuildState.WizardStep == 3 ? "active" : "")"
                disabled="@(!BuildState.Divisions.Any())"
                @onclick="() => GoToStep(3)">
            <span class="step-num">3</span> Fill Divisions
        </button>
    </div>

    @* ── Step content ── *@
    <div class="be-content">

        @if (BuildState.WizardStep == 1)
        {
            <ArmySelector BuildState="BuildState"
                          OnArmySelected="OnArmySelected" />
        }
        else if (BuildState.WizardStep == 2)
        {
            <DivisionBuilder BuildState="BuildState"
                             OnChanged="OnBuildChanged"
                             OnNext="() => GoToStep(3)" />
        }
        else if (BuildState.WizardStep == 3)
        {
            <DivisionDetail BuildState="BuildState"
                            OnChanged="OnBuildChanged" />
        }
    </div>

    @* ── Points summary ── *@
    <PointsSummary BuildState="BuildState"
                   ValidationMessages="ValidationMessages"
                   OnSave="OpenSaveDialog"
                   OnPrint="PrintList"
                   IsAuthenticated="IsAuthenticated" />

    @* ── Save dialog ── *@
    @if (ShowSaveDialog)
    {
        <div class="dialog-backdrop" @onclick="CloseSaveDialog">
            <div class="dialog" @onclick:stopPropagation>
                <h3>Save army list</h3>
                <input class="be-input" placeholder="List name e.g. Austerlitz 1805"
                       @bind="SaveName" />
                @if (!string.IsNullOrEmpty(SaveError))
                {
                    <p class="error-msg">@SaveError</p>
                }
                <div class="dialog-actions">
                    <button class="btn-secondary" @onclick="CloseSaveDialog">Cancel</button>
                    <button class="btn-primary" @onclick="SaveBuild" disabled="@Saving">
                        @(Saving ? "Saving…" : "Save")
                    </button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public string? ShareToken { get; set; }

    private ArmyBuildState BuildState { get; set; } = new();
    private List<ValidationMessage> ValidationMessages { get; set; } = new();
    private int TotalPoints => PointsCalc.CalculateTotalPoints(BuildState);
    private string PointsClass => TotalPoints > 300 ? "pts-over" : TotalPoints >= 200 ? "pts-ok" : "pts-low";
    private bool IsAuthenticated { get; set; }
    private string? UserId { get; set; }

    private bool ShowSaveDialog;
    private string SaveName = string.Empty;
    private string? SaveError;
    private bool Saving;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        IsAuthenticated = auth.User.Identity?.IsAuthenticated ?? false;
        UserId = auth.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(ShareToken))
            await LoadSharedBuild(ShareToken);
    }

    private async Task OnArmySelected(Army army)
    {
        BuildState.SelectedArmyId = army.ArmyId;
        BuildState.Army = await ArmyData.GetArmyWithDivisionsAsync(army.ArmyId);
        BuildState.Divisions.Clear();
        BuildState.WizardStep = 2;
        Revalidate();
    }

    private void OnBuildChanged()
    {
        Revalidate();
        StateHasChanged();
    }

    private void GoToStep(int step) => BuildState.WizardStep = step;

    private void Revalidate() =>
        ValidationMessages = PointsCalc.ValidateBuild(BuildState);

    private void OpenSaveDialog()
    {
        SaveName = BuildState.Army?.Name ?? "My Army";
        ShowSaveDialog = true;
    }

    private void CloseSaveDialog() { ShowSaveDialog = false; SaveError = null; }

    private async Task SaveBuild()
    {
        if (string.IsNullOrWhiteSpace(SaveName)) { SaveError = "Please enter a name"; return; }
        if (UserId == null) { SaveError = "You must be logged in to save"; return; }

        Saving = true;
        try
        {
            await BuildService.SaveBuildAsync(
                UserId, BuildState.SelectedArmyId!.Value, SaveName, BuildState);
            CloseSaveDialog();
        }
        catch (Exception ex)
        {
            SaveError = $"Save failed: {ex.Message}";
        }
        finally { Saving = false; }
    }

    private async Task LoadSharedBuild(string ***REMOVED***)
    {
        var build = await BuildService.GetBuildByShareTokenAsync(***REMOVED***);
        // TODO: deserialise BuildJson back into BuildState.Divisions
        // This requires re-loading the division types and unit types from the DB
        // and matching them by ID from the saved JSON.
    }

    private void PrintList() => Nav.NavigateTo($"/army-builder/print", true);
}
