@page "/random-army"
@using System.Linq

@using System.Collections.Generic
@using DracoStandardSite.Components
@using DracoStandardSite.Data
@using DracoStandardSite.Models


@inject IRankingsService ArmyService

<h3>Random Army Selector</h3>

@if (armies == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div>
        <label for="regionSelect">Filter by Region:</label>
        <select id="regionSelect" @bind="selectedRegion">
            <option value="">All</option>
            @foreach (var region in regions)
            {
                <option value="@region">@region</option>
            }
        </select>

        <div>
            <input type="checkbox" @bind="filterZeroUsed" />
            <label for="filterZeroUsed"> Only show armies with 0 uses</label>
        </div>


        <button @onclick="GenerateRandomArmy">Generate Random Army</button>

        @if (randomArmy != null)
        {
            <p>Random Army: @randomArmy.Army (@randomArmy.Region)</p>
        }
    </div>
}

@code {
    private List<ArmyIndex> armies;
    private List<string> regions;
    private string selectedRegion = "";
    private ArmyIndex randomArmy;
    private List<ArmyUsed> armyUsedData;
    private bool filterZeroUsed = false;


    protected override async Task OnInitializedAsync()
    {
        armies = await ArmyService.GetArmyIndexes();
        regions = armies.Select(a => a.Region).Distinct().ToList();
        armyUsedData = await ArmyService.GetAllArmyUseds();

    }

    private void GenerateRandomArmy()
    {
        var filteredArmies = armies.AsEnumerable();


        if (filterZeroUsed)
        {
            var usedArmyIds = armyUsedData.Select(a => a.ArmyId).Distinct().ToHashSet();
            filteredArmies = filteredArmies.Where(a => !usedArmyIds.Contains(a.No));
        }

        var filteredArmiesList = filteredArmies.ToList();

        if (filteredArmies.Count() > 0)
        {
            var random = new Random();
            randomArmy = filteredArmiesList[random.Next(filteredArmies.Count())];
        }
        else
        {
            randomArmy = null;
        }
    }
}
