@page "/army-regions"
@using ApexCharts
@using System.Linq
@using System.Collections.Generic
@using DracoStandardSite.Components
@using DracoStandardSite.Data
@using DracoStandardSite.Models

@inject IRankingsService service

<h3>Pie Chart of Army Regions</h3>

@if (aList == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div style="width: 100%; max-width: 600px; height: 400px; margin: 0 auto;">
        <ApexChart TItem="ChartData" Title="Army Use by Region">
            <ApexPointSeries TItem="ChartData"
                             Items="chartData"
                             Name="Region"
                             SeriesType="SeriesType.Pie"
                             XValue="@(r => r.Region)"
                             YValue="@(r => r.Count)">
            </ApexPointSeries>
        </ApexChart>
    </div>
}

@code {
    [Parameter]
    public List<ArmyUsed> aList { get; set; }

    private List<ChartData> chartData;

    protected override async Task OnParametersSetAsync()
    {
        if (aList == null)
        {
            aList = await service.GetAllArmyUseds();
        }

        if (aList != null)
        {
            chartData = aList
                .GroupBy(a => a.Region)
                .Select(g => new ChartData { Region = g.Key, Count = g.Count() })
                .ToList();
        }
    }

    public class ChartData
    {
        public string Region { get; set; }
        public int Count { get; set; }
    }
}
