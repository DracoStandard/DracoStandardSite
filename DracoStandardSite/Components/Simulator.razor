@page "/combatsimulation"
@using System.Linq
@using DracoStandardSite.Components
@inject NavigationManager NavigationHelper

@using DracoStandardSite.Data
@using DracoStandardSite.Models

@using System.IO
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq

@inject IArmyBuilderService service

@inject IJSRuntime JS

<h1>MEG Combat Simulator</h1>
<h3>Instructions</h3>
Chose the characteristics of the two units you want to compare and the number of repetitions of the simulation. The simulation will run and display the results below.
Notes fls = foot long spear, mme = mounted melee expert and so on...
you can only input solid blocks (eg 3x2) for the number of files and rows

@if (isDataLoaded)
{
    <EditForm Model="this" OnValidSubmit="RunSimulation">
        <h2>TUG A</h2>
        <div class="row">
