@page "/combatsimulation"
@using System.Linq
@using DracoStandardSite.Components
@inject NavigationManager NavigationHelper

@using DracoStandardSite.Data
@using DracoStandardSite.Models

@using System.IO
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq

@inject IArmyBuilderService service

@inject IJSRuntime JS

<h3>MEG Combat Simulation</h3>

@if (isDataLoaded)
{
    <h2>TUG1</h2>
    <form>
          <div class="row">
            <div class="col-md-6">
        <div class="form-group">
            <label for="tug1Type">Type</label>
            <select id="tug1Type" class="form-control" @bind="tug1Type">
                @foreach (var option in typeOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="tug1Quality">Quality</label>
            <select id="tug1Quality" class="form-control" @bind="tug1Quality">
                @foreach (var option in qualityOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="tug1Files">Files</label>
            <input type="number" id="tug1Files" class="form-control" @bind="tug1Files" min="1" />
        </div>
        <div class="form-group">
            <label for="tug1Rows">Rows</label>
            <input type="number" id="tug1Rows" class="form-control" @bind="tug1Rows" min="1" />
        </div>
        <div class="form-group">
            <label for="tug1Melee">Melee</label>
            <select id="tug1Melee" class="form-control" @bind="tug1Melee">
                @foreach (var option in meleeOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="tug1Char1">Char1</label>
            <select id="tug1Char1" class="form-control" @bind="tug1Char1">
                @foreach (var option in charOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="tug1Char2">Char2</label>
            <select id="tug1Char2" class="form-control" @bind="tug1Char2">
                @foreach (var option in charOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="tug1Char3">Char3</label>
            <select id="tug1Char3" class="form-control" @bind="tug1Char3">
                @foreach (var option in charOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
               </div>
            </div></div>
             <div class="row">

            <div class="col-md-6">

        <h2>TUG2</h2>
        <div class="form-group">
            <label for="tug2Type">Type</label>
            <select id="tug2Type" class="form-control" @bind="tug2Type">
                @foreach (var option in typeOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="tug2Quality">Quality</label>
            <select id="tug2Quality" class="form-control" @bind="tug2Quality">
                @foreach (var option in qualityOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="tug2Files">Files</label>
            <input type="number" id="tug2Files" class="form-control" @bind="tug2Files" min="1" />
        </div>
        <div class="form-group">
            <label for="tug2Rows">Rows</label>
            <input type="number" id="tug2Rows" class="form-control" @bind="tug2Rows" min="1" />
        </div>
        <div class="form-group">
            <label for="tug2Melee">Melee</label>
            <select id="tug2Melee" class="form-control" @bind="tug2Melee">
                @foreach (var option in meleeOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="tug2Char1">Char1</label>
            <select id="tug2Char1" class="form-control" @bind="tug2Char1">
                @foreach (var option in charOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="tug2Char2">Char2</label>
            <select id="tug2Char2" class="form-control" @bind="tug2Char2">
                @foreach (var option in charOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="tug2Char3">Char3</label>
            <select id="tug2Char3" class="form-control" @bind="tug2Char3">
                @foreach (var option in charOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        </div></div>


        <div class="form-group">
            <label for="numRepetitions">Number of Repetitions:</label>
            <input type="number" id="numRepetitions" @bind="numRepetitions" min="1" />
        </div>
        <button @onclick="RunSimulation">Run Simulation</button>
    </form>

    @if (results != null)
    {
        <h4>Results:</h4>
        <p>Wins: @results.Wins</p>
        <p>Draws: @results.Draws</p>
        <p>Losses: @results.Losses</p>
    }
}
else
{
    <p>Loading...</p>
}

@code {



    private Ug UGA;

    private Ug UGB;


    private string? tug1Type;
    private string? tug1Quality;
    private int? tug1Files;
    private int? tug1Rows;
    private string? tug1Melee;
    private string? tug1Char1;
    private string? tug1Char2;
    private string? tug1Char3;

    private string? tug2Type;
    private string? tug2Quality;
    private int? tug2Files;
    private int? tug2Rows;
    private string? tug2Melee;
    private string? tug2Char1;
    private string? tug2Char2;
    private string? tug2Char3;

    private List<string> tug1Characteristics = new List<string>();
    private List<string> tug2Characteristics = new List<string>();

    private int numRepetitions = 1000;

    private List<string> typeOptions = new List<string>();
    private List<string> qualityOptions = new List<string>();
    private List<string> meleeOptions = new List<string>();
    private List<string> charOptions = new List<string>();

    private bool isDataLoaded = false;

    private CombatResults results;


    int outcome;


    protected override async Task OnInitializedAsync()
    {
        typeOptions = await service.GetUniqueTypes();
        qualityOptions = await service.GetUniqueQualities();
        meleeOptions = await service.GetUniqueMeleeWeaponries();
        charOptions = await service.GetUniqueMandatoryCharacteristics(); // Assuming Char1, Char2, Char3 are from MandatoryCharacteristics
        isDataLoaded = true;
    }

    private void RunSimulation()
    {
        // Combine characteristics into lists
        tug1Characteristics = new List<string> { tug1Char1, tug1Char2, tug1Char3 };
        tug2Characteristics = new List<string> { tug2Char1, tug2Char2, tug2Char3 };

        // Create UGA
        UGA = new Ug(tug1Quality, tug1Type, tug1Melee, tug1Characteristics, tug1Rows ?? 1, tug1Files ?? 1);

        // Create UGB
        UGB = new Ug(tug2Quality, tug2Type, tug2Melee, tug2Characteristics, tug2Rows ?? 1, tug2Files ?? 1);

        outcome = 0;
        
        for (int i = 0; i < numRepetitions; i++)
        {

           outcome += UGA.combat(UGB);
        }
    }

    private class CombatResults
    {
        public int Wins { get; set; }
        public int Draws { get; set; }
        public int Losses { get; set; }
    }

   
}
