                    </select>
                </div>
            </div>
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug2Quality">Quality</label>
                    <select id="tug2Quality" class="form-control" @bind="tug2Quality">
                        <option value="">-- Select Quality --</option>
                        @foreach (var option in qualityOptions)
                        {
