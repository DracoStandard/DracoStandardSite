                    </select>
                </div>
            </div>
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug1Quality">Quality</label>
                    <select id="tug1Quality" class="form-control" @bind="tug1Quality">
                        <option value="">-- Select Quality --</option>
                        @foreach (var option in qualityOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug1Protection">Protection</label>
                    <select id="tug1Protection" class="form-control" @bind="tug1Protection">
                        <option value="">-- Select Protection --</option>
                        @foreach (var option in protOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
            </div>
   
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug1Melee">Weapon</label>
                    <select id="tug1Melee" class="form-control" @bind="tug1Melee">
                        <option value="">-- Select Melee --</option>
                        @foreach (var option in meleeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug1Char1">Char1</label>
                    <select id="tug1Char1" class="form-control" @bind="tug1Char1">
                        <option value="">-- Select Char1 --</option>
                        @foreach (var option in charOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug1Char2">Char2</label>
                    <select id="tug1Char2" class="form-control" @bind="tug1Char2">
                        <option value="">-- Select Char2 --</option>
                        @foreach (var option in charOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug1Char3">Char3</label>
                    <select id="tug1Char3" class="form-control" @bind="tug1Char3">
                        <option value="">-- Select Char3 --</option>
                        @foreach (var option in charOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug1Files">Files</label>
                    <input type="number" id="tug1Files" class="form-control" @bind="tug1Files" min="1" placeholder="Enter number" />
                </div>
            </div>
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug1Rows">Ranks</label>
                    <input type="number" id="tug1Rows" class="form-control" @bind="tug1Rows" min="1" placeholder="Enter number" />
                </div>
            </div>
        </div>

        <h2>TUG B</h2>
        <div class="row">
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug2Type">Type</label>
                    <select id="tug2Type" class="form-control" @bind="tug2Type">
                        <option value="">-- Select Type --</option>
                        @foreach (var option in typeOptions)
                        {
