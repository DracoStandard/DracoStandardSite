        </div>
    </EditForm>

    <h4>Simulation Results:</h4>
    <p>A Wins: @awin</p>
    <p>B Wins: @dwin</p>
}
else
{
    <p>Loading...</p>
}

@code {
    private Ug UGA;
    private Ug UGB;

    private string? tug1Type;
    private string? tug1Quality;
    private string? tug1Protection;
    private int? tug1Files;
    private int? tug1Rows;
    private string? tug1Melee;
    private string? tug1Char1;
    private string? tug1Char2;
    private string? tug1Char3;

    private string? tug2Type;
    private string? tug2Quality;
    private string? tug2Protection;
    private int? tug2Files;
    private int? tug2Rows;
    private string? tug2Melee;
    private string? tug2Char1;
    private string? tug2Char2;
    private string? tug2Char3;

    private List<string> tug1Characteristics = new();
    private List<string> tug2Characteristics = new();

    private int numRepetitions = 10;

    private List<string> typeOptions = new() { "inf", "cav", "el" };
    private List<string> qualityOptions = new() { "x", "s", "a", "p" };
    private List<string> meleeOptions = new() { "fss", "iw", "fls", "pk", "fpa", "cl", "mls", "mpa", "mss", "2hc" };
    private List<string> charOptions = new() { "cs", "fme", "mme", "fdc", "mdc", "shv", "sw" };
    private List<string> protOptions = new() { "fa", "p", "u" };

    private bool isDataLoaded = false;

    int awin;
    int dwin;

    protected override async Task OnInitializedAsync()
    {
        isDataLoaded = true;
    }

    private async void RunSimulation()
    {
        // Collect characteristics
        tug1Characteristics = new List<string> { tug1Char1, tug1Char2, tug1Char3 }
            .Where(x => !string.IsNullOrWhiteSpace(x)).ToList();

        tug2Characteristics = new List<string> { tug2Char1, tug2Char2, tug2Char3 }
            .Where(x => !string.IsNullOrWhiteSpace(x)).ToList();

        // Construct UGs
        UGA = new Ug(tug1Quality, tug1Type, tug1Melee, tug1Protection, tug1Characteristics,
                     tug1Rows ?? 1, tug1Files ?? 1);

        UGB = new Ug(tug2Quality, tug2Type, tug2Melee, tug2Protection, tug2Characteristics,
                     tug2Rows ?? 1, tug2Files ?? 1);

        // Reset results
        awin = 0;
        dwin = 0;

        // --- Run Updated Battle Engine ---
        for (int i = 0; i < numRepetitions; i++)
        {
            var engine = new BattleEngine(UGA, UGB);
            string result = engine.RunBattle();

            if (result == "a") awin++;
            if (result == "d") dwin++;
        }

        StateHasChanged();
    }
}
