            </div>
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug2Char2">Char2</label>
                    <select id="tug2Char2" class="form-control" @bind="tug2Char2">
                        <option value="">-- Select Char2 --</option>
                        @foreach (var option in charOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-sm">
                <div class="form-group">
                    <label for="tug2Char3">Char3</label>
                    <select id="tug2Char3" class="form-control" @bind="tug2Char3">
                        <option value="">-- Select Char3 --</option>
                        @foreach (var option in charOptions)
                        {
