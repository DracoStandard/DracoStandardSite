<h3>Players</h3>

@using DracoStandardSite.Data
@using DracoStandardSite.Models


@inject IRankingsService service

@inject NavigationManager UriHelper

<ResultsByPlayer @ref="Modal" PID=@PID></ResultsByPlayer>


@if (RList == null)
{
    <p><em>Loading...</em></p>
}
else

{
    <ol class = "list-group-numbered">
      @foreach (var player in RList)
            {
       

            <li class="list-group-item d-flex justify-content-between align-items-start" >
                <div class="ms-2 me-auto">
                    <div class="fw-bold">@player.Name</div>
                    Score: @player.RankScore
                </div>
                <span class="badge bg-primary rounded-pill">@player.CompsPlayed</span>
                <button type="button" class="btn btn-primary" @onclick="()=>openModal(player.PlayerId)">Details</button>
             </li>
             }

     </ol>

     @if (PlayerDialogOpen)
{



}
}



    @code {
        [Parameter] public string gameSystem { get; set; }
        public bool PlayerDialogOpen { get; set; }

        List<AllRankings> RList;



        Guid PID;
        private ResultsByPlayer Modal { get; set; }
       
        private async Task openModal( Guid p)


        {
           
            PID = p;
            Modal.Open();
         StateHasChanged();
        }

  

    protected override async Task OnParametersSetAsync()
    {


        RList = await service.getRankings(gameSystem, false);
    }





   
}