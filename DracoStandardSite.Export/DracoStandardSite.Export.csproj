<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reads the rankings data from SQL Server and writes it as JSON files for the
    static site. Uses the same user-secrets store as the original web project,
    so the connection string you already have locally works without extra setup.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e5e71bbe-5d54-4ab2-a5aa-14f9365fcef3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DracoStandardSite.Shared\DracoStandardSite.Shared.csproj" />
  </ItemGroup>

</Project>
